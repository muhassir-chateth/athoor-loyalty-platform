{%- comment -%}
  Slide-in wishlist drawer (cart-style). Trigger: [data-wishlist-drawer-open].
  Matches the cart drawer styling of Athoor London.
{%- endcomment -%}

<style>
  /* ============================================
     WISHLIST DRAWER — Cart-style sidebar
     ============================================ */
  .wl-drawer {
    position: fixed;
    inset: 0;
    z-index: 10001;
    visibility: hidden;
    pointer-events: none;
  }
  .wl-drawer.active { visibility: visible; pointer-events: auto; }

  .wl-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .wl-drawer.active .wl-drawer__overlay { opacity: 1; }

  .wl-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 420px;
    max-width: 94vw;
    background: #fff;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.08);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }
  .wl-drawer.active .wl-drawer__panel { transform: translateX(0); }

  /* ---- Header ---- */
  .wl-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #e8e4de;
    flex-shrink: 0;
  }
  .wl-drawer__title {
    font-family: var(--font-heading-family, 'Helvetica Neue', sans-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
    color: #1a1a1a;
  }
  .wl-drawer__close {
    background: none;
    border: none;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    color: #1a1a1a;
    padding: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wl-drawer__close:hover { color: #666; }

  /* ---- Body / Items Area ---- */
  .wl-drawer__body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0;
  }

  /* ---- Empty State ---- */
  .wl-drawer .dtx-grid-empty {
    text-align: center;
    padding: 60px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .wl-drawer .dtx-grid-empty h2 {
    font-family: var(--font-heading-family, 'Helvetica Neue', sans-serif);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #1a1a1a;
    margin: 0 0 8px;
  }
  .wl-drawer .wl-empty-note {
    font-size: 12px;
    line-height: 1.6;
    color: #8a8079;
    font-weight: 300;
    max-width: 240px;
    margin: 0 0 24px;
  }
  .wl-drawer .dtx-grid-empty .button {
    display: inline-block;
    background: #1a1a1a;
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 28px;
    text-decoration: none;
    border: none;
  }
  .wl-drawer .dtx-grid-empty .button:hover { background: #333; }
  .wl-drawer .dtx-grid-empty.dtx-grid-hide { display: none; }

  /* ---- Table / Grid Items ---- */
  .wl-drawer .dtx-table { display: none; width: 100%; }
  .wl-drawer .dtx-table.dtx-grid-show { display: block; }
  .wl-drawer .dtx-table thead { display: none; }
  .wl-drawer .dtx-table,
  .wl-drawer .dtx-table tbody { display: block; width: 100%; }

  /* Each wishlist item — like a cart line item */
  .wl-drawer .dtx-table tr {
    display: grid;
    grid-template-columns: 72px 1fr 28px;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      "img name remove"
      "img price remove"
      "img cta cta";
    column-gap: 14px;
    row-gap: 4px;
    padding: 18px 24px;
    border-bottom: 1px solid #f0ece6;
    align-items: start;
  }
  .wl-drawer .dtx-table tr.grid_template { display: none !important; }

  .wl-drawer .dtx-table td {
    display: block;
    padding: 0;
    border: none;
  }

  /* Thumbnail */
  .wl-drawer .product-thumbnail {
    grid-area: img;
    width: 72px;
    height: 90px;
    background: #f8f6f2;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .wl-drawer .product-thumbnail a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .wl-drawer .product-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 4px;
  }

  /* Product Name + Price stacked */
  .wl-drawer .product-name {
    grid-area: name;
    align-self: end;
  }
  .wl-drawer .product-name a {
    font-family: var(--font-heading-family, 'Helvetica Neue', sans-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #1a1a1a;
    text-decoration: none;
    line-height: 1.4;
    display: block;
  }
  .wl-drawer .product-name a:hover { color: #6b6258; }

  .wl-drawer .product-price-cart {
    grid-area: price;
    font-size: 13px;
    font-weight: 400;
    color: #6b6258;
    margin-top: 0;
    align-self: start;
  }

  /* Shop / CTA button */
  .wl-drawer .product-wishlist-cart {
    grid-area: cta;
  }
  .wl-drawer .product-wishlist-cart a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 20px;
    text-decoration: none;
    border: none;
    width: 100%;
    text-align: center;
    min-width: unset;
    transition: background 0.2s ease;
  }
  .wl-drawer .product-wishlist-cart a:hover { background: #333; }

  /* Remove button — top right of item */
  .wl-drawer .dtx-table tr td:last-child {
    grid-area: remove;
    align-self: start;
    justify-self: end;
    padding-top: 2px;
  }
  .wl-drawer .remove-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #999;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .wl-drawer .remove-item:hover { color: #1a1a1a; }
  .wl-drawer .remove-item svg { width: 14px; height: 14px; }
  .wl-drawer .remove-item .icon-remove { display: none; }

  /* ---- Footer ---- */
  .wl-drawer__footer {
    flex-shrink: 0;
    padding: 18px 24px;
    border-top: 1px solid #e8e4de;
    text-align: center;
  }
  .wl-drawer__footer a {
    display: block;
    width: 100%;
    background: #1a1a1a;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 15px 24px;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s ease;
  }
  .wl-drawer__footer a:hover { background: #333; }

  /* ---- Mobile adjustments ---- */
  @media screen and (max-width: 479px) {
    .wl-drawer__panel {
      width: 100%;
      max-width: 100vw;
    }
    .wl-drawer .dtx-table tr {
      grid-template-columns: 64px 1fr 24px;
      padding: 14px 16px;
      column-gap: 12px;
    }
    .wl-drawer .product-thumbnail {
      width: 64px;
      height: 80px;
    }
    .wl-drawer__header {
      padding: 16px 16px;
    }
    .wl-drawer__footer {
      padding: 14px 16px;
    }
  }
</style>

<div class="wl-drawer" id="WishlistDrawer" aria-hidden="true">
  <div class="wl-drawer__overlay" data-wishlist-drawer-close></div>
  <div class="wl-drawer__panel" role="dialog" aria-modal="true" aria-label="Wishlist">

    <!-- Header -->
    <div class="wl-drawer__header">
      <h2 class="wl-drawer__title">Your Wishlist</h2>
      <button type="button" class="wl-drawer__close" data-wishlist-drawer-close aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Body -->
    <div class="wl-drawer__body">
      <div class="dtx-grid-empty dtx-grid-show" id="AthoorWlDrawerEmpty">
        <h2>Your wishlist is empty</h2>
        <p class="wl-empty-note">Tap the heart on any fragrance to save it here.</p>
        <a href="{{ routes.all_products_collection_url }}" class="link button button--primary">
          Continue Shopping
        </a>
      </div>
      <table class="dtx-table" id="AthoorWlDrawerTable">
        <tbody id="AthoorWlDrawerBody"></tbody>
      </table>
    </div>

    <!-- Footer -->
    <div class="wl-drawer__footer">
      <a href="/pages/wishlist">View Full Wishlist</a>
    </div>

  </div>
</div>

<script>
  (function () {
    if (window.__athoorWlDrawerInit) return;
    window.__athoorWlDrawerInit = true;
    var drawer = document.getElementById('WishlistDrawer');
    if (!drawer) return;

    var WISH_KEY = 'shopify-wishlist';

    function getWishlist() {
      return (localStorage.getItem(WISH_KEY) || '').split(',').filter(Boolean);
    }
    function saveWishlist(list) {
      if (list.length) localStorage.setItem(WISH_KEY, list.join(','));
      else localStorage.removeItem(WISH_KEY);
      var countEl = document.querySelector('.dtxc-wishlist-count');
      if (countEl) countEl.setAttribute('count', list.length);
    }

    function buildRow(parts) {
      var title = parts[1], handle = parts[2], image = parts[3], price = parts[6];
      var url = '/products/' + handle;
      var tr = document.createElement('tr');
      tr.id = 'wldrow_' + handle;
      tr.innerHTML =
        '<td class="product-thumbnail"><a href="' + url + '"><img loading="lazy" src="' + image + '" alt="' + title + '"></a></td>' +
        '<td class="product-name"><a href="' + url + '">' + title + '</a></td>' +
        '<td class="product-price-cart">' + price + '</td>' +
        '<td class="product-wishlist-cart"><a href="' + url + '" class="dt-sc-btn button product-cart">Shop</a></td>' +
        '<td><a href="javascript:void(0);" class="remove-item product-cart" data-wldrawer-remove="' + handle + '"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></a></td>';
      return tr;
    }

    function render() {
      var wishlist = getWishlist();
      var empty = document.getElementById('AthoorWlDrawerEmpty');
      var table = document.getElementById('AthoorWlDrawerTable');
      var tbody = document.getElementById('AthoorWlDrawerBody');
      if (!empty || !table || !tbody) return;

      var countEl = document.querySelector('.dtxc-wishlist-count');
      if (countEl) countEl.setAttribute('count', wishlist.length);

      if (wishlist.length === 0) {
        empty.classList.add('dtx-grid-show'); empty.classList.remove('dtx-grid-hide');
        table.classList.remove('dtx-grid-show'); table.classList.add('dtx-grid-hide');
        tbody.innerHTML = '';
        return;
      }

      var fetches = wishlist.map(function(handle) {
        return fetch('/products/' + handle + '?view=json')
          .then(function(r) { return r.ok ? r.text() : ''; })
          .then(function(t) { return t ? t.trim() : ''; })
          .catch(function() { return ''; });
      });

      Promise.all(fetches).then(function(results) {
        tbody.innerHTML = '';
        var count = 0;
        results.forEach(function(record) {
          if (!record || record.indexOf('~~') === -1) return;
          var parts = record.split('~~');
          if (parts.length < 7) return;
          tbody.appendChild(buildRow(parts));
          count++;
        });
        if (count > 0) {
          empty.classList.remove('dtx-grid-show'); empty.classList.add('dtx-grid-hide');
          table.classList.add('dtx-grid-show'); table.classList.remove('dtx-grid-hide');
        } else {
          empty.classList.add('dtx-grid-show'); empty.classList.remove('dtx-grid-hide');
          table.classList.remove('dtx-grid-show'); table.classList.add('dtx-grid-hide');
        }
      });
    }

    function open() {
      drawer.classList.add('active');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      render();
    }
    function close() {
      drawer.classList.remove('active');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-wishlist-drawer-open]')) { e.preventDefault(); open(); return; }
      if (e.target.closest('[data-wishlist-drawer-close]')) { e.preventDefault(); close(); return; }
      var rm = e.target.closest('[data-wldrawer-remove]');
      if (rm) {
        e.preventDefault();
        var handle = rm.getAttribute('data-wldrawer-remove');
        var list = getWishlist();
        var idx = list.indexOf(handle);
        if (idx > -1) list.splice(idx, 1);
        saveWishlist(list);
        var row = document.getElementById('wldrow_' + handle);
        if (row) row.remove();
        if (list.length === 0) render();
      }
    });
    document.addEventListener('keyup', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('active')) close();
    });
  })();
</script>
