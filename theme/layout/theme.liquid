<script>
document.addEventListener("DOMContentLoaded", function() {

  if(localStorage.getItem("clubPopupClosed")){
    return;
  }

  setTimeout(function() {

    var popup = document.getElementById("club-popup");

    if(popup){
      popup.style.display = "flex";
    }

  }, 3000);

  var closeBtn = document.getElementById("close-popup");

  if(closeBtn){

    closeBtn.onclick = function(){

      document.getElementById("club-popup").style.display = "none";

      localStorage.setItem("clubPopupClosed","yes");

    };

  }

});
</script>

<script>
document.addEventListener('mousemove', function(e) {

  if (Math.random() > 0.15) return;

  const particle = document.createElement('div');

  particle.innerHTML = '✦';
  particle.style.position = 'fixed';
  particle.style.left = e.clientX + 'px';
  particle.style.top = e.clientY + 'px';
  particle.style.color = '#D6C28A';
  particle.style.pointerEvents = 'none';
  particle.style.zIndex = '999998';

  document.body.appendChild(particle);

  particle.animate([
    {
      transform: 'translate(0,0) scale(1)',
      opacity: 1
    },
    {
      transform: 'translate(-15px,-20px) scale(0.5)',
      opacity: 0
    }
  ], {
    duration: 800,
    easing: 'ease-out'
  });

  setTimeout(() => {
    particle.remove();
  }, 800);

});
</script>
