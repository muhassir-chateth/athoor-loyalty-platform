  <div id="horse-cursor"></div>
  <script>

document.addEventListener('DOMContentLoaded', function () {

  const cursor = document.getElementById('horse-cursor');

  cursor.style.backgroundImage =
    "url('https://cdn.shopify.com/s/files/1/0954/4613/9219/files/LOGO1.png?v=1780463990')";

  document.addEventListener('mousemove', function(e) {
    cursor.style.left = e.clientX + 'px';
    cursor.style.top = e.clientY + 'px';
  });

  // On clickable controls: show the normal pointer + hide the logo cursor
  var interactiveSel = 'a, button, [role="button"], input, select, textarea, label, summary, .button, .athoor-rec__add, .shopify-payment-button__button, .quantity__button';
  document.addEventListener('mouseover', function(e) {
    if (e.target.closest && e.target.closest(interactiveSel)) {
      document.documentElement.classList.add('athoor-native-cursor');
      cursor.style.opacity = '0';
    }
  });
  document.addEventListener('mouseout', function(e) {
    if (e.target.closest && e.target.closest(interactiveSel)) {
      document.documentElement.classList.remove('athoor-native-cursor');
      cursor.style.opacity = '0.9';
    }
  });

  document.querySelectorAll('.card-wrapper').forEach(card => {

    card.addEventListener('mouseenter', function() {
  cursor.style.transform =
  'translate(-50%, -50%) scale(1.5)';
  cursor.style.opacity = '1';
});

card.addEventListener('mouseleave', function() {
  cursor.style.transform =
  'translate(-50%, -50%) scale(1)';
  cursor.style.opacity = '0.9';
});

  });

});
</script>

