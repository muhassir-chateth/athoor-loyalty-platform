{%- comment -%} Custom Sample Set product page — choose 1 or 3 fragrance samples {%- endcomment -%}
{%- assign v1 = 54074344997203 -%}{%- comment -%} 1 Sample £2.99 {%- endcomment -%}
{%- assign v3 = 54077951050067 -%}{%- comment -%} 3 Samples £5.99 {%- endcomment -%}
{%- assign frag_handles = "identity,gissah-d-aura,old-money" | split: "," -%}

{%- style -%}
  .breadcrumb { display: none !important; }
  .ss-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px 70px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .ss-media {
    background: #f0ebe4;
    border-radius: 4px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ss-media img { width: 80%; height: 80%; object-fit: contain; }
  .ss-media--placeholder { color: #b3a99c; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }

  .ss-info { }
  .ss-eyebrow {
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    color: #8a8079; margin: 0 0 10px;
  }
  .ss-title {
    font-family: Georgia, serif; font-size: 30px; font-weight: 400;
    letter-spacing: 0.03em; text-transform: uppercase; margin: 0 0 8px; color: #1a1a1a;
  }
  .ss-subtitle { font-size: 14px; color: #6b6258; font-weight: 300; margin: 0 0 24px; line-height: 1.6; }

  .ss-label { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #1a1a1a; margin: 0 0 12px; font-weight: 600; }

  /* Set size options */
  .ss-sizes { display: flex; gap: 12px; margin-bottom: 28px; }
  .ss-size {
    flex: 1; border: 1px solid #d8d2c8; border-radius: 4px; padding: 16px 12px;
    text-align: center; cursor: pointer; transition: all 0.25s ease; background: #fff;
  }
  .ss-size.is-active { border-color: #1a1a1a; background: #1a1a1a; color: #fff; }
  .ss-size__name { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .ss-size__price { font-size: 13px; margin-top: 4px; opacity: 0.85; }

  /* Fragrance choices */
  .ss-frags { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; }
  .ss-frag {
    display: flex; align-items: flex-start; gap: 14px; border: 1px solid #e3dcd0;
    border-radius: 4px; padding: 14px; cursor: pointer; transition: all 0.2s ease; background: #fff;
  }
  .ss-frag.is-selected { border-color: #1a1a1a; background: #faf8f5; }
  .ss-frag.is-disabled { opacity: 0.4; pointer-events: none; }
  .ss-frag__img { width: 52px; height: 52px; flex-shrink: 0; background: #f0ebe4; border-radius: 3px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .ss-frag__img img { width: 78%; height: 78%; object-fit: contain; mix-blend-mode: multiply; }
  .ss-frag__info { flex: 1; text-align: left; }
  .ss-frag__name { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; margin: 0 0 2px; color: #1a1a1a; }
  .ss-frag__type { font-size: 11px; color: #8a8079; margin: 0; }

  /* Fragrance notes (from product metafields) */
  .ss-frag__notes { margin: 8px 0 0; display: flex; flex-direction: column; gap: 3px; }
  .ss-frag__note { font-size: 11px; color: #6b6258; line-height: 1.45; }
  .ss-frag__note b {
    display: inline-block; min-width: 42px; font-size: 9px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: #a59b8d;
  }
  .ss-frag__check {
    width: 22px; height: 22px; border: 1px solid #cfcac2; border-radius: 50%; flex-shrink: 0;
    margin-top: 2px;
    display: flex; align-items: center; justify-content: center;
  }
  .ss-frag.is-selected .ss-frag__check { background: #1a1a1a; border-color: #1a1a1a; }
  .ss-frag.is-selected .ss-frag__check:after { content: ""; width: 7px; height: 7px; background: #fff; border-radius: 50%; }

  .ss-hint { font-size: 12px; color: #8a8079; margin: 0 0 18px; }
  .ss-add {
    width: 100%; height: 54px; background: #1a1a1a; color: #fff; border: none;
    border-radius: 4px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
    cursor: pointer; transition: background 0.3s ease;
  }
  .ss-add:hover { background: #B8960C; }
  .ss-add:disabled { opacity: 0.4; cursor: not-allowed; }
  /* Coming Soon button — always disabled, no hover change */
  .ss-add.ss-coming-soon,
  .ss-add.ss-coming-soon:hover {
    background: #1a1a1a !important;
    opacity: 0.55 !important;
    cursor: not-allowed !important;
  }
  .ss-coming-note {
    font-size: 12px;
    color: #8a8079;
    text-align: center;
    margin: 12px 0 0;
    line-height: 1.5;
    font-weight: 300;
  }
  .ss-more { text-align: center; font-size: 12px; margin-top: 12px; }
  .ss-more a { color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; }

  @media screen and (max-width: 749px) {
    .ss-page { grid-template-columns: 1fr; gap: 20px; padding: 24px 18px 50px; }
    .ss-media { max-width: 260px; margin: 0 auto; }
    .ss-title { font-size: 22px; }
    .ss-subtitle { font-size: 13px; margin-bottom: 18px; }
    .ss-size { padding: 12px 8px; }
    .ss-size__name { font-size: 12px; }
    .ss-frag__name { font-size: 12px; }
    .ss-frag__note { font-size: 10px; }
    .ss-frag__note b { min-width: 38px; font-size: 8px; }
    .ss-add { height: 50px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="ss-page">
  <div class="ss-media">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy" width="800" height="800">
    {%- else -%}
      <span class="ss-media--placeholder">Add sample set image</span>
    {%- endif -%}
  </div>

  <div class="ss-info">
    <p class="ss-eyebrow">Discovery Set</p>
    <h1 class="ss-title">{{ product.title }}</h1>
    <p class="ss-subtitle">Try before you commit. Choose your favourite My Athoor London scents in 1.2ml sample sizes.</p>

    <form id="ss-form" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
      <input type="hidden" name="id" id="ss-variant" value="{{ v1 }}">

      <p class="ss-label">Choose your set</p>
      <div class="ss-sizes">
        <div class="ss-size is-active" data-size="1" data-variant="{{ v1 }}" data-max="1">
          <div class="ss-size__name">1 Sample</div>
          <div class="ss-size__price">£2.99</div>
        </div>
        <div class="ss-size" data-size="3" data-variant="{{ v3 }}" data-max="3">
          <div class="ss-size__name">3 Samples</div>
          <div class="ss-size__price">£5.99</div>
        </div>
      </div>

      <p class="ss-label">Select your fragrance<span data-plural style="display:none;">s</span></p>
      <p class="ss-hint" data-hint>Choose 1 fragrance</p>

      <div class="ss-frags">
        {%- for handle in frag_handles -%}
          {%- assign fp = all_products[handle] -%}
          {%- if fp != blank -%}
            <div class="ss-frag" data-frag data-name="{{ fp.title | escape }}">
              <div class="ss-frag__img">
                {%- if fp.featured_image -%}
                  <img src="{{ fp.featured_image | image_url: width: 150 }}" alt="{{ fp.title | escape }}" loading="lazy" width="150" height="150">
                {%- endif -%}
              </div>
              <div class="ss-frag__info">
                <p class="ss-frag__name">{{ fp.title }}</p>
                <p class="ss-frag__type">{{ fp.type | default: 'Extrait de Parfum' }}</p>
                {%- assign n_top = fp.metafields.notes.top.value -%}
                {%- assign n_heart = fp.metafields.notes.heart.value -%}
                {%- assign n_base = fp.metafields.notes.base.value -%}
                {%- if n_top != blank or n_heart != blank or n_base != blank -%}
                  <div class="ss-frag__notes">
                    {%- if n_top != blank -%}<span class="ss-frag__note"><b>Top</b>{{ n_top }}</span>{%- endif -%}
                    {%- if n_heart != blank -%}<span class="ss-frag__note"><b>Heart</b>{{ n_heart }}</span>{%- endif -%}
                    {%- if n_base != blank -%}<span class="ss-frag__note"><b>Base</b>{{ n_base }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              <span class="ss-frag__check"></span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <input type="hidden" name="properties[Scent 1]" id="ss-prop-1" disabled>
      <input type="hidden" name="properties[Scent 2]" id="ss-prop-2" disabled>
      <input type="hidden" name="properties[Scent 3]" id="ss-prop-3" disabled>

      <button type="button" class="ss-add ss-coming-soon" id="ss-add" disabled>Coming Soon</button>
      <p class="ss-coming-note">This product is coming soon and is not yet available for purchase.</p>
      <p class="ss-more"><a href="{{ routes.all_products_collection_url }}">View all fragrances</a></p>
    </form>
  </div>
</div>

<script>
(function() {
  var form = document.getElementById('ss-form');
  if (!form) return;
  var sizes = form.querySelectorAll('.ss-size');
  var frags = form.querySelectorAll('[data-frag]');
  var variantInput = document.getElementById('ss-variant');
  var addBtn = document.getElementById('ss-add');
  var hint = form.querySelector('[data-hint]');
  var plural = form.querySelector('[data-plural]');
  var props = [
    document.getElementById('ss-prop-1'),
    document.getElementById('ss-prop-2'),
    document.getElementById('ss-prop-3')
  ];
  var maxSel = 1;
  var price = '£2.99';
  var selected = [];

  function refresh() {
    // selection visuals + disable when max reached
    frags.forEach(function(f) {
      var name = f.getAttribute('data-name');
      var isSel = selected.indexOf(name) !== -1;
      f.classList.toggle('is-selected', isSel);
      f.classList.toggle('is-disabled', !isSel && selected.length >= maxSel);
    });
    // properties
    props.forEach(function(p, i) {
      if (selected[i]) { p.value = selected[i]; p.disabled = false; }
      else { p.value = ''; p.disabled = true; }
    });
    hint.textContent = 'Choose ' + maxSel + ' fragrance' + (maxSel > 1 ? 's' : '') + ' (' + selected.length + '/' + maxSel + ')';
    plural.style.display = maxSel > 1 ? 'inline' : 'none';
    // Product is Coming Soon — button always stays disabled, never enables checkout
    addBtn.disabled = true;
    addBtn.textContent = 'Coming Soon';
  }

  // Block any form submission for this coming-soon product
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    e.stopPropagation();
    return false;
  });

  sizes.forEach(function(s) {
    s.addEventListener('click', function() {
      sizes.forEach(function(x){ x.classList.remove('is-active'); });
      s.classList.add('is-active');
      maxSel = parseInt(s.getAttribute('data-max'), 10);
      price = s.querySelector('.ss-size__price').textContent;
      variantInput.value = s.getAttribute('data-variant');
      selected = selected.slice(0, maxSel);
      refresh();
    });
  });

  frags.forEach(function(f) {
    f.addEventListener('click', function() {
      var name = f.getAttribute('data-name');
      var idx = selected.indexOf(name);
      if (idx !== -1) {
        selected.splice(idx, 1);
      } else if (selected.length < maxSel) {
        selected.push(name);
      }
      refresh();
    });
  });

  refresh();
})();
</script>
