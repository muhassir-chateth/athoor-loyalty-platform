{%- style -%}
  /* Hide the breadcrumb/page banner on this page */
  .breadcrumb { display: none !important; }

  .lv-login {
    max-width: 440px;
    margin: 0 auto;
    padding: 36px 20px 60px;
    color: #1a1a1a;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  .lv-login__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }
  .lv-login__top h1 {
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.01em;
    margin: 0;
  }
  .lv-login__close { font-size: 20px; line-height: 1; text-decoration: none; color: #1a1a1a; }

  .lv-login__h2 {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.01em;
    margin: 0 0 16px;
  }

  .lv-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 48px;
    border: 1px solid #1a1a1a;
    border-radius: 40px;
    background: #fff;
    font-size: 13px;
    font-weight: 400;
    color: #1a1a1a;
    cursor: pointer;
    margin-bottom: 10px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .lv-social:hover { background: #f9f7f4; }
  .lv-social svg { width: 16px; height: 16px; }

  .lv-or {
    text-align: center;
    font-size: 13px;
    color: #1a1a1a;
    margin: 18px 0;
  }

  .lv-mandatory {
    text-align: right;
    font-size: 11px;
    color: #1a1a1a;
    margin-bottom: 10px;
  }

  .lv-field { margin-bottom: 18px; position: relative; }
  .lv-field label {
    display: block;
    font-size: 12px;
    margin-bottom: 6px;
    color: #1a1a1a;
  }
  .lv-field input {
    width: 100%;
    height: 48px;
    padding: 0 40px 0 14px;
    border: 1px solid #cfcac2;
    border-radius: 2px;
    background: #fff;
    font-size: 14px;
    color: #1a1a1a;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }
  .lv-field input:focus { outline: none; border-color: #1a1a1a; }
  .lv-eye {
    position: absolute;
    right: 12px;
    top: 34px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #5a5450;
  }
  .lv-eye svg { width: 18px; height: 18px; }

  .lv-forgot {
    display: inline-block;
    font-size: 12px;
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-bottom: 16px;
  }
  .lv-otl {
    font-size: 12px;
    color: #1a1a1a;
    line-height: 1.5;
    margin: 0 0 18px;
  }
  .lv-otl a { color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; }

  .lv-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 48px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 400;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .lv-btn:hover { opacity: 0.85; }
  .lv-btn--outline {
    background: #fff;
    color: #1a1a1a;
    border: 1px solid #1a1a1a;
  }
  .lv-btn--outline:hover { background: #f9f7f4; opacity: 1; }

  .lv-divider { border: none; border-top: 1px solid #e3dcd0; margin: 28px 0; }

  .lv-noaccount h2 { font-size: 15px; font-weight: 400; margin: 0 0 8px; }
  .lv-noaccount p { font-size: 12px; color: #6b6b6b; line-height: 1.6; margin: 0 0 16px; font-weight: 300; }

  .lv-join { text-align: center; padding-top: 4px; }
  .lv-join__title {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: #1a1a1a;
    margin: 0 0 20px;
  }
  .lv-join__item {
    padding: 14px 0;
    border-top: 1px solid #ece6dd;
  }
  .lv-join__item:first-of-type { border-top: none; }
  .lv-join__item h3 {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 4px;
  }
  .lv-join__item p {
    font-size: 11px;
    line-height: 1.5;
    color: #8a8079;
    margin: 0 auto;
    max-width: 280px;
    font-weight: 300;
  }

  @media screen and (max-width: 749px) { .lv-login { padding: 28px 18px 50px; } }
{%- endstyle -%}

<div class="lv-login">
  <div class="lv-login__top">
    <h1>My Account</h1>
    <a href="{{ routes.root_url }}" class="lv-login__close" aria-label="Close">&times;</a>
  </div>

  <h2 class="lv-login__h2">I already have an account</h2>

  <a href="{{ routes.account_login_url }}" class="lv-social">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
    Sign in with Google
  </a>

  <a href="{{ routes.account_login_url }}" class="lv-social">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#000" d="M16.36 12.78c-.02-2.02 1.65-2.99 1.72-3.04-.94-1.37-2.4-1.56-2.92-1.58-1.24-.13-2.43.73-3.06.73-.63 0-1.6-.71-2.64-.69-1.36.02-2.61.79-3.31 2-1.41 2.45-.36 6.07 1.01 8.06.67.97 1.47 2.06 2.51 2.02 1.01-.04 1.39-.65 2.61-.65 1.22 0 1.56.65 2.63.63 1.09-.02 1.78-.99 2.45-1.97.77-1.12 1.09-2.21 1.11-2.27-.02-.01-2.13-.82-2.15-3.24zM14.38 6.84c.56-.68.94-1.62.83-2.56-.81.03-1.79.54-2.37 1.21-.52.6-.97 1.56-.85 2.48.9.07 1.83-.46 2.39-1.13z"/></svg>
    Sign in with Apple
  </a>

  <p class="lv-or">Or</p>

  <p class="lv-mandatory">Mandatory Fields*</p>

  <div class="lv-field">
    <label for="LvEmail">Login*</label>
    <input type="email" id="LvEmail" autocomplete="email" autocorrect="off" autocapitalize="off">
  </div>

  <div class="lv-field">
    <label for="LvPassword">Password*</label>
    <input type="password" id="LvPassword" autocomplete="current-password">
    <button type="button" class="lv-eye" data-lv-eye aria-label="Show password">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/><line x1="4" y1="4" x2="20" y2="20"/></svg>
    </button>
  </div>

  <a href="{{ routes.account_login_url }}" class="lv-forgot">Forgot your password?</a>

  <p class="lv-otl">Or use a one-time login link to sign in. <a href="{{ routes.account_login_url }}">Email me the link</a></p>

  <a href="{{ routes.account_login_url }}" class="lv-btn">Sign In</a>

  <hr class="lv-divider">

  <div class="lv-noaccount">
    <h2>I don't have an account</h2>
    <p>Enjoy added benefits and a richer experience by creating a personal account</p>
    <a href="{{ routes.account_register_url }}" class="lv-btn lv-btn--outline">Create an Account</a>
  </div>

  <hr class="lv-divider">

  <div class="lv-join">
    <h2 class="lv-join__title">Join My Athoor London</h2>

    <div class="lv-join__item">
      <h3>Track Your Orders</h3>
      <p>Follow your orders every step of the way.</p>
    </div>

    <div class="lv-join__item">
      <h3>Streamline Checkout</h3>
      <p>Check out faster with saved addresses and payment methods.</p>
    </div>

    <div class="lv-join__item">
      <h3>Book an Appointment</h3>
      <p>Enjoy priority access to the boutique of your choice at the time and date that suits you.</p>
    </div>
  </div>
</div>

<script>
(function() {
  var eye = document.querySelector('[data-lv-eye]');
  if (eye) {
    eye.addEventListener('click', function() {
      var input = document.getElementById('LvPassword');
      if (!input) return;
      input.type = input.type === 'password' ? 'text' : 'password';
    });
  }
})();
</script>
