                {%- endif -%}
              </a>
              <button type="button" class="athoor-bs-wish" data-bs-wish="{{ product.handle }}" aria-label="Add to Wishlist">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
              <button type="button" class="athoor-bs-addcart" data-bs-cart="{{ product.selected_or_first_available_variant.id }}" aria-label="Add to Cart">
