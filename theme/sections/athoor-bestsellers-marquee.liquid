</section>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
(function() {
  /* Pure CSS marquee — no Swiper. Continuous scroll via CSS animation.
     Desktop hover pause = animation-play-state:paused (pixel-perfect, zero shake).
     Mobile continuous, no touch interaction. All handled in CSS. */

  /* ===== Mobile touch pause/resume for CSS marquee ===== */
  (function() {
    var el = document.querySelector('.athoor-bs-swiper');
    if (!el) return;
    el.addEventListener('touchstart', function() { el.classList.add('is-touching'); }, { passive: true });
    el.addEventListener('touchend', function() { el.classList.remove('is-touching'); }, { passive: true });
    el.addEventListener('touchcancel', function() { el.classList.remove('is-touching'); }, { passive: true });
  })();

  /* ===== Bestsellers Wishlist + Add-to-Cart (event delegation) ===== */
  (function() {
    var WISH_KEY = 'shopify-wishlist';

    function getWishlist() {
      return (localStorage.getItem(WISH_KEY) || '').split(',').filter(Boolean);
    }
    function saveWishlist(list) {
      if (list.length) localStorage.setItem(WISH_KEY, list.join(','));
      else localStorage.removeItem(WISH_KEY);
      var countEl = document.querySelector('.dtxc-wishlist-count');
      if (countEl) countEl.setAttribute('count', list.length);
    }

    function bsToast(message) {
      var existing = document.querySelector('.athoor-edp-toast, .athoor-bs-toast');
      if (existing) existing.remove();
      var toast = document.createElement('div');
      toast.className = 'athoor-bs-toast';
      toast.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><span>' + message + '</span>';
      document.body.appendChild(toast);
      requestAnimationFrame(function() { toast.classList.add('is-visible'); });
      setTimeout(function() {
        toast.classList.remove('is-visible');
        setTimeout(function() { toast.remove(); }, 400);
      }, 2500);
    }

    // Robust cart bubble updater — creates, updates, or removes the header cart count
    function updateCartBubble(count) {
      var cartIcon = document.getElementById('cart-icon-bubble');
      if (!cartIcon) return;
      var bubble = cartIcon.querySelector('.cart-count-bubble');
      if (count > 0) {
        if (!bubble) {
          bubble = document.createElement('div');
          bubble.className = 'cart-count-bubble';
          bubble.innerHTML = '<span aria-hidden="true"></span>';
          cartIcon.appendChild(bubble);
        }
        var span = bubble.querySelector('span[aria-hidden="true"]') || bubble.querySelector('span');
        if (span) span.textContent = count < 100 ? count : '';
        bubble.style.display = '';
      } else {
        // Cart empty — remove/hide the bubble
        if (bubble) bubble.remove();
      }
    }

    // Fly-to-header animation: a small dot flies from the clicked button to the header icon
    function flyToHeader(sourceEl, targetSelector, color) {
      var target = document.querySelector(targetSelector);
      if (!target || !sourceEl) return;
      var srcRect = sourceEl.getBoundingClientRect();
      var tgtRect = target.getBoundingClientRect();
      var dot = document.createElement('div');
      dot.className = 'athoor-fly-dot';
      dot.style.background = color || '#1a1a1a';
      dot.style.left = (srcRect.left + srcRect.width / 2) + 'px';
      dot.style.top = (srcRect.top + srcRect.height / 2) + 'px';
      document.body.appendChild(dot);
      requestAnimationFrame(function() {
        dot.style.transform = 'translate(' + (tgtRect.left + tgtRect.width / 2 - srcRect.left - srcRect.width / 2) + 'px, ' + (tgtRect.top + tgtRect.height / 2 - srcRect.top - srcRect.height / 2) + 'px) scale(0.3)';
        dot.style.opacity = '0.4';
      });
      setTimeout(function() {
        dot.remove();
        // Pulse the target icon
        target.classList.add('athoor-header-pulse');
        setTimeout(function() { target.classList.remove('athoor-header-pulse'); }, 500);
      }, 500);
    }

    // Mark hearts active on load
    function syncHearts() {
      var list = getWishlist();
      document.querySelectorAll('.athoor-bs-wish[data-bs-wish]').forEach(function(h) {
        if (list.indexOf(h.getAttribute('data-bs-wish')) > -1) h.classList.add('is-active');
        else h.classList.remove('is-active');
      });
    }
    syncHearts();
    setTimeout(syncHearts, 1000); // catch swiper clones

    document.addEventListener('click', function(e) {
      var wishBtn = e.target.closest('.athoor-bs-wish');
      var cartBtn = e.target.closest('.athoor-bs-addcart');

      if (wishBtn) {
        e.preventDefault();
        e.stopPropagation();
        var handle = wishBtn.getAttribute('data-bs-wish');
        var list = getWishlist();
        var idx = list.indexOf(handle);
        if (idx > -1) {
          list.splice(idx, 1);
          saveWishlist(list);
          // Unmark all hearts for this handle (clones included)
          document.querySelectorAll('.athoor-bs-wish[data-bs-wish="' + handle + '"]').forEach(function(h){ h.classList.remove('is-active'); });
          bsToast('Removed from Wishlist');
        } else {
          list.push(handle);
          saveWishlist(list);
          document.querySelectorAll('.athoor-bs-wish[data-bs-wish="' + handle + '"]').forEach(function(h){ h.classList.add('is-active'); });
          wishBtn.classList.add('is-animating');
          setTimeout(function(){ wishBtn.classList.remove('is-animating'); }, 400);
          flyToHeader(wishBtn, '.header__icon--wishlist', '#c0392b');
          bsToast('Added to Wishlist');
        }
        return;
      }

      if (cartBtn) {
        e.preventDefault();
        e.stopPropagation();
        var variantId = cartBtn.getAttribute('data-bs-cart');
        if (!variantId) return;

        // Toggle: if already added, remove from cart and reset color
        if (cartBtn.classList.contains('is-added')) {
          cartBtn.classList.remove('is-added');
          bsToast('Removed from Cart');
          // Remove item from cart
          fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: 0 })
          }).then(function(r){ return r.json(); }).then(function(cart){
            updateCartBubble(cart.item_count);
          });
          return;
        }

        // Add to cart
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
        })
        .then(function(r){ return r.json(); })
        .then(function() {
          cartBtn.classList.add('is-added');
          flyToHeader(cartBtn, '#cart-icon-bubble', '#1a1a1a');
          bsToast('Added to Cart');
          fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
            updateCartBubble(cart.item_count);
          });
        })
        .catch(function(){ bsToast('Could not add to cart'); });
        return;
      }
    });
  })();
})();
</script>

<style>
/* Bestsellers toast (shared premium style) */
.athoor-bs-toast {
  position: fixed;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  opacity: 0;
  z-index: 100000;
  background: rgba(26, 26, 26, 0.88);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  color: #fff;
  padding: 12px 20px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  letter-spacing: 0.02em;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  transition: opacity 0.35s ease, transform 0.35s ease;
  pointer-events: none;
}
.athoor-bs-toast svg { width: 16px; height: 16px; color: #c0392b; flex-shrink: 0; }
.athoor-bs-toast.is-visible { opacity: 1; transform: translateX(-50%) translateY(0); }
@media screen and (max-width: 749px) {
  .athoor-bs-toast { bottom: 20px; font-size: 12px; padding: 10px 16px; }
}

/* Fly-to-header dot animation */
.athoor-fly-dot {
  position: fixed;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  z-index: 2147483647;
  pointer-events: none;
  opacity: 1;
  transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease;
}
/* Header icon pulse when item arrives */
.athoor-header-pulse {
  animation: athoorPulseHeader 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes athoorPulseHeader {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}
</style>

{% schema %}
{
  "name": "Bestsellers Marquee",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "BEST SELLERS" },
    { "type": "text", "id": "title", "label": "Title", "default": "Bestsellers" },
    { "type": "text", "id": "description", "label": "Description", "default": "Timeless favourites, loved by many." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 3, "max": 12, "step": 1, "default": 6, "label": "Products to show" },
    { "type": "checkbox", "id": "show_bottle_image", "label": "Show Identity bottle accent", "default": false }
  ],
  "presets": [ { "name": "Bestsellers Marquee" } ]
}
{% endschema %}
