{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
/* === Athoor Bestsellers Section === */
.athoor-bestsellers {
  padding: 60px 0 72px;
  overflow: hidden;
  background: #faf8f5;
}

.athoor-bestsellers__header {
  text-align: center;
  margin-bottom: 40px;
  padding: 0 20px;
}

.athoor-bestsellers__subtitle {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #8C8279;
  margin: 0 0 10px;
  font-weight: 400;
}

.athoor-bestsellers__title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 32px;
  font-weight: 400;
  letter-spacing: 0.02em;
  margin: 0;
  color: #1a1a1a;
}

.athoor-bestsellers__subtitle-text {
  font-size: 14px;
  color: #6b6b6b;
  margin: 8px 0 0;
  font-weight: 300;
  letter-spacing: 0.01em;
}

/* Pure CSS marquee container */
.athoor-bs-swiper {
  overflow: hidden !important;
  position: relative;
}

/* The track: flex row of all (duplicated) slides, scrolling continuously */
.athoor-bs-swiper .swiper-wrapper {
  display: flex !important;
  width: max-content !important;
  animation: athoorBsMarquee 18s linear infinite;
  will-change: transform;
}

/* Desktop: slightly faster + pause EXACTLY where it is on hover (zero shake, resumes exactly) */
@media screen and (min-width: 750px) {
  .athoor-bs-swiper .swiper-wrapper {
    animation-duration: 14s;
  }
  .athoor-bs-swiper:hover .swiper-wrapper {
    animation-play-state: paused;
  }
}

/* Mobile: pause on touch, resume on release — same exact pixel-perfect freeze */
@media screen and (max-width: 749px) {
  .athoor-bs-swiper.is-touching .swiper-wrapper {
    animation-play-state: paused;
  }
}

.athoor-bs-swiper .swiper-slide {
  width: 300px;
  padding: 0 14px;
  flex: 0 0 auto;
}

/* Track scrolls one full set (products are duplicated 2x for a seamless loop) */
@keyframes athoorBsMarquee {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(-50%, 0, 0); }
}

/* Product Card — Atkinsons minimal style */
.athoor-bs-card {
  text-align: center;
}

.athoor-bs-card__imgwrap {
  position: relative;
  margin-bottom: 18px;
}

.athoor-bs-card__img {
  position: relative;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-decoration: none;
  margin-bottom: 0;
}

.athoor-bs-card__img img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  mix-blend-mode: multiply;
  transition: transform 0.5s ease;
}

.athoor-bs-card:hover .athoor-bs-card__img img {
  transform: scale(1.04);
}

.athoor-bs-soon {
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 2;
  background: #1a1a1a;
  color: #fff;
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 5px 9px;
  border-radius: 3px;
}

/* Wishlist + Cart action icons — top-right of image, stacked */
.athoor-bs-wish,
.athoor-bs-addcart {
  position: absolute;
  right: 10px;
  z-index: 3;
  background: rgba(255,255,255,0.85);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  border: none;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  transition: transform 0.2s ease, background 0.2s ease;
  padding: 0;
}
.athoor-bs-wish { top: 10px; }
.athoor-bs-addcart { bottom: 10px; top: auto; }
.athoor-bs-wish svg,
.athoor-bs-addcart svg {
  width: 18px;
  height: 18px;
  stroke: #1a1a1a;
  fill: none;
  transition: fill 0.3s ease, stroke 0.3s ease;
}
.athoor-bs-wish:hover,
.athoor-bs-addcart:hover {
  transform: scale(1.1);
  background: rgba(255,255,255,0.95);
}
.athoor-bs-wish.is-active svg { fill: #c0392b; stroke: #c0392b; }
.athoor-bs-wish.is-animating {
  animation: athoorBsWishPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes athoorBsWishPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.35); }
  100% { transform: scale(1); }
}
.athoor-bs-addcart.is-added svg { stroke: #1a1a1a; fill: #1a1a1a; }

@media screen and (max-width: 749px) {
  .athoor-bs-wish, .athoor-bs-addcart { width: 32px; height: 32px; right: 8px; }
  .athoor-bs-wish { top: 8px; }
  .athoor-bs-addcart { bottom: 8px; top: auto; }
  .athoor-bs-wish svg, .athoor-bs-addcart svg { width: 16px; height: 16px; }
}

.athoor-bs-card__type {
  font-size: 11px;
  color: #8a8079;
  margin: 0 0 8px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 400;
}

.athoor-bs-card__name {
  font-size: 16px;
  font-weight: 700;
  text-transform: uppercase;
  margin: 0 0 10px;
  letter-spacing: 0.02em;
  line-height: 1.25;
  color: #1a1a1a;
}

.athoor-bs-card__name a {
  text-decoration: none;
  color: #1a1a1a;
}

.athoor-bs-card__tagline {
  font-size: 14px;
  color: #6b6258;
  margin: 0;
  font-weight: 300;
  line-height: 1.5;
}

/* Responsive */
@media screen and (max-width: 749px) {
  .athoor-bestsellers {
    padding: 44px 0 52px;
  }

  .athoor-bestsellers__title {
    font-size: 26px;
  }

  .athoor-bestsellers__header {
    margin-bottom: 28px;
  }

  .athoor-bs-swiper .swiper-slide {
    width: 78vw;
    max-width: 320px;
    padding: 0 10px;
  }

  .athoor-bs-card__type {
    font-size: 11px;
  }

  .athoor-bs-card__name {
    font-size: 17px;
  }

  .athoor-bs-card__tagline {
    font-size: 14px;
  }
}

@media screen and (min-width: 750px) and (max-width: 989px) {
  .athoor-bs-swiper .swiper-slide {
    width: 300px;
  }
}

@media screen and (min-width: 990px) {
  .athoor-bestsellers__title {
    font-size: 36px;
  }

  .athoor-bs-swiper .swiper-slide {
    width: 300px;
    padding: 0 16px;
  }
}

/* Scrollbar progress indicator */
.athoor-bs-progress {
  width: 240px;
  height: 2px;
  background: #e3dcd0;
  margin: 30px auto 0;
  border-radius: 2px;
  position: relative;
  overflow: hidden;
}
.athoor-bs-progress__bar {
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(90deg, #1a1a1a 0, #1a1a1a 60px, transparent 60px, transparent 240px);
  background-size: 240px 100%;
  animation: athoorProgressLoop 5s linear infinite;
}
@keyframes athoorProgressLoop {
  from { background-position: 0 0; }
  to { background-position: 240px 0; }
}
{%- endstyle -%}

