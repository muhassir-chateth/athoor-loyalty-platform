                  {%- if section.settings.bottom_menu != blank -%}
                    <ul class="footer-block__details-content {% unless block.settings.list_style == 'vertical' %}list-menu list-menu--inline {% endunless %}list-unstyled {{ section.settings.alignment }}">
                      {%- for link in section.settings.bottom_menu.links -%}
                        <li>
                          <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
