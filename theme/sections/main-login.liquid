{%- style -%}
  .lv-login {
    max-width: 460px;
    margin: 0 auto;
    padding: 40px 22px 70px;
    color: #1a1a1a;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  .lv-login__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
  }
  .lv-login__top h1 {
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.01em;
    margin: 0;
  }
  .lv-login__close { font-size: 22px; line-height: 1; text-decoration: none; color: #1a1a1a; }

  .lv-login__h2 {
    font-size: 18px;
    font-weight: 400;
    margin: 0 0 22px;
    letter-spacing: 0.01em;
  }

  .lv-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 54px;
    border: 1px solid #1a1a1a;
    border-radius: 40px;
    background: #fff;
    font-size: 15px;
    color: #1a1a1a;
    cursor: pointer;
    margin-bottom: 14px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .lv-social:hover { background: #f5f1ec; }
  .lv-social svg, .lv-social img { width: 18px; height: 18px; }

  .lv-or {
    text-align: center;
    font-size: 14px;
    color: #1a1a1a;
    margin: 22px 0;
  }

  .lv-mandatory {
    text-align: right;
    font-size: 12px;
    color: #1a1a1a;
    margin-bottom: 14px;
  }
  .lv-mandatory span { color: #1a1a1a; }

  .lv-field { margin-bottom: 22px; position: relative; }
  .lv-field label {
    display: block;
    font-size: 13px;
    margin-bottom: 8px;
    color: #1a1a1a;
  }
  .lv-field input {
    width: 100%;
    height: 50px;
    padding: 0 44px 0 14px;
    border: 1px solid #cfcac2;
    border-radius: 2px;
    background: #fff;
    font-size: 15px;
    color: #1a1a1a;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }
  .lv-field input:focus { outline: none; border-color: #1a1a1a; }
  .lv-eye {
    position: absolute;
    right: 12px;
    top: 38px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #5a5450;
  }
  .lv-eye svg { width: 20px; height: 20px; }

  .lv-forgot {
    display: inline-block;
    font-size: 13px;
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-bottom: 24px;
  }
  .lv-otl {
    font-size: 13px;
    color: #1a1a1a;
    margin: 0 0 22px;
    line-height: 1.5;
  }
  .lv-otl a { color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; }

  .lv-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 56px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 40px;
    font-size: 15px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .lv-btn:hover { opacity: 0.85; }
  .lv-btn--outline {
    background: #fff;
    color: #1a1a1a;
    border: 1px solid #1a1a1a;
    text-decoration: none;
  }
  .lv-btn--outline:hover { background: #f5f1ec; opacity: 1; }

  .lv-divider { border: none; border-top: 1px solid #e3dcd0; margin: 36px 0; }

  .lv-noaccount h2 { font-size: 18px; font-weight: 400; margin: 0 0 12px; }
  .lv-noaccount p { font-size: 13px; color: #8C8279; line-height: 1.6; margin: 0 0 22px; font-weight: 300; }

  /* Join (Gucci style) */
  .lv-join { text-align: center; }
  .lv-join__title {
    font-size: 18px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 30px;
  }
  .lv-join__item { margin-bottom: 26px; }
  .lv-join__item h3 {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .lv-join__item p {
    font-size: 14px;
    line-height: 1.6;
    color: #5a5450;
    margin: 0 auto;
    max-width: 360px;
    font-weight: 300;
  }

  .lv-login__msg { font-size: 13px; padding: 12px 14px; border-radius: 2px; margin-bottom: 18px; }
  .lv-login__msg--error { background: #fcebeb; color: #b3261e; }
  .lv-login__msg--success { background: #edf6ed; color: #2e7d32; }

  #lv-recover { display: none; }
  #lv-recover:target { display: block; }
  #lv-recover:target ~ #lv-signin { display: none; }

  @media screen and (max-width: 749px) { .lv-login { padding: 28px 18px 50px; } }
{%- endstyle -%}

<div class="lv-login">
  <div class="lv-login__top">
    <h1>{{ section.settings.page_title }}</h1>
    <a href="{{ routes.root_url }}" class="lv-login__close" aria-label="Close">&times;</a>
  </div>

  {%- comment -%} Recover password (toggled) {%- endcomment -%}
  <div id="lv-recover">
    <h2 class="lv-login__h2">{{ 'customer.recover_password.title' | t }}</h2>
    <p class="lv-otl">{{ 'customer.recover_password.subtext' | t }}</p>
    {%- form 'recover_customer_password' -%}
      {% assign recover_success = form.posted_successfully? %}
      <div class="lv-field">
        <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}*</label>
        <input type="email" name="email" id="RecoverEmail" autocorrect="off" autocapitalize="off" autocomplete="email"
          {% if form.errors %}aria-invalid="true" autofocus{% endif %}>
      </div>
      {%- if form.errors -%}<div class="lv-login__msg lv-login__msg--error">{{ form.errors.messages['form'] }}</div>{%- endif -%}
      <button type="submit" class="lv-btn">{{ 'customer.login_page.submit' | t }}</button>
      <a href="#lv-signin" class="lv-forgot" style="margin-top:16px;">{{ 'customer.login_page.cancel' | t }}</a>
    {%- endform -%}
  </div>

  {%- comment -%} Sign in {%- endcomment -%}
  <div id="lv-signin">
    <h2 class="lv-login__h2">{{ section.settings.signin_heading }}</h2>

    {%- if section.settings.show_google -%}
      <a href="{{ routes.account_login_url }}" class="lv-social">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Sign in with Google
      </a>
    {%- endif -%}
    {%- if section.settings.show_apple -%}
      <a href="{{ routes.account_login_url }}" class="lv-social">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#000" d="M16.36 12.78c-.02-2.02 1.65-2.99 1.72-3.04-.94-1.37-2.4-1.56-2.92-1.58-1.24-.13-2.43.73-3.06.73-.63 0-1.6-.71-2.64-.69-1.36.02-2.61.79-3.31 2-1.41 2.45-.36 6.07 1.01 8.06.67.97 1.47 2.06 2.51 2.02 1.01-.04 1.39-.65 2.61-.65 1.22 0 1.56.65 2.63.63 1.09-.02 1.78-.99 2.45-1.97.77-1.12 1.09-2.21 1.11-2.27-.02-.01-2.13-.82-2.15-3.24zM14.38 6.84c.56-.68.94-1.62.83-2.56-.81.03-1.79.54-2.37 1.21-.52.6-.97 1.56-.85 2.48.9.07 1.83-.46 2.39-1.13z"/></svg>
        Sign in with Apple
      </a>
    {%- endif -%}

    {%- if section.settings.show_google or section.settings.show_apple -%}
      <p class="lv-or">Or</p>
    {%- endif -%}

    {%- if recover_success == true -%}
      <div class="lv-login__msg lv-login__msg--success">{{ 'customer.recover_password.success' | t }}</div>
    {%- endif -%}

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="lv-login__msg lv-login__msg--error">{{ form.errors | default_errors }}</div>{%- endif -%}

      <p class="lv-mandatory">Mandatory Fields<span>*</span></p>

      <div class="lv-field">
        <label for="CustomerEmail">{{ section.settings.login_label }}*</label>
        <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off"
          {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}>
      </div>

      {%- if form.password_needed -%}
        <div class="lv-field">
          <label for="CustomerPassword">{{ 'customer.login_page.password' | t }}*</label>
          <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password"
            {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}>
          <button type="button" class="lv-eye" data-lv-eye aria-label="Show password">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
          </button>
        </div>
        <a href="#lv-recover" class="lv-forgot">{{ 'customer.login_page.forgot_password' | t }}</a>
      {%- endif -%}

      {%- if section.settings.show_onetime -%}
        <p class="lv-otl">Or use a one-time login link to sign in. <a href="#lv-recover">Email me the link</a></p>
      {%- endif -%}

      <button type="submit" class="lv-btn">{{ 'customer.login_page.sign_in' | t }}</button>
    {%- endform -%}

    <hr class="lv-divider">

    <div class="lv-noaccount">
      <h2>{{ section.settings.noaccount_heading }}</h2>
      <p>{{ section.settings.noaccount_text }}</p>
      <a href="{{ routes.account_register_url }}" class="lv-btn lv-btn--outline">{{ section.settings.cta_label }}</a>
    </div>

    {%- comment -%} JOIN section (Gucci style) — editable via blocks {%- endcomment -%}
    <hr class="lv-divider">
    <div class="lv-join">
      {%- if section.settings.join_title != blank -%}
        <h2 class="lv-join__title">{{ section.settings.join_title }}</h2>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <div class="lv-join__item" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      <hr class="lv-divider">
      {%- form 'guest_login' -%}
        <button type="submit" class="lv-btn lv-btn--outline">{{ 'customer.login_page.guest_continue' | t }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  var eye = document.querySelector('[data-lv-eye]');
  if (eye) {
    eye.addEventListener('click', function() {
      var input = document.getElementById('CustomerPassword');
      if (!input) return;
      input.type = input.type === 'password' ? 'text' : 'password';
    });
  }
})();
</script>

{% schema %}
{
  "name": "Login",
  "settings": [
    { "type": "text", "id": "page_title", "label": "Page title", "default": "My Account" },
    { "type": "text", "id": "signin_heading", "label": "Sign-in heading", "default": "I already have an account" },
    { "type": "text", "id": "login_label", "label": "Email field label", "default": "Login" },
    { "type": "header", "content": "Social sign-in buttons" },
    { "type": "checkbox", "id": "show_google", "label": "Show 'Sign in with Google'", "default": true },
    { "type": "checkbox", "id": "show_apple", "label": "Show 'Sign in with Apple'", "default": true },
    { "type": "paragraph", "content": "Note: Google/Apple sign-in require a social login app to function. The buttons are styled to match the design." },
    { "type": "checkbox", "id": "show_onetime", "label": "Show one-time login link text", "default": true },
    { "type": "header", "content": "Create account section" },
    { "type": "text", "id": "noaccount_heading", "label": "Heading", "default": "I don't have an account" },
    { "type": "textarea", "id": "noaccount_text", "label": "Text", "default": "Enjoy added benefits and a richer experience by creating a personal account" },
    { "type": "text", "id": "cta_label", "label": "Create account button label", "default": "Create an Account" },
    { "type": "header", "content": "Join section (below Create Account)" },
    { "type": "text", "id": "join_title", "label": "Join heading", "default": "Join My Athoor London" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Track Your Orders" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Follow your orders every step of the way." }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
