{%- style -%}
  .athoor-tv {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  .athoor-tv__header {
    text-align: center;
    margin-bottom: 36px;
    padding: 0 20px;
  }
  .athoor-tv__eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ section.settings.gold_color }};
    margin: 0 0 10px;
    font-weight: 400;
  }
  .athoor-tv__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 30px;
    font-weight: 400;
    letter-spacing: 0.03em;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .athoor-tv__track {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
    padding: 0 20px;
  }

  /* Card — portrait 9:16 */
  .athoor-tv-card {
    position: relative;
    width: 320px;
    max-width: 88vw;
    aspect-ratio: 9 / 16;
    border-radius: 4px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 18px 50px rgba(0,0,0,0.22);
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s cubic-bezier(0.22,1,0.36,1), transform 0.9s cubic-bezier(0.22,1,0.36,1);
  }
  .athoor-tv-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Review overlay (shown first) */
  .athoor-tv-card__review {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 34px 26px;
    background: linear-gradient(160deg, #1a1a1a 0%, #000 100%);
    color: #fff;
    transition: opacity 1s ease, visibility 1s ease;
  }
  .athoor-tv-card.show-video .athoor-tv-card__review {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .athoor-tv-card__stars {
    color: {{ section.settings.gold_color }};
    font-size: 16px;
    letter-spacing: 3px;
    margin-bottom: 20px;
  }
  .athoor-tv-card__quote {
    font-family: Georgia, serif;
    font-size: 17px;
    line-height: 1.6;
    font-weight: 400;
    letter-spacing: 0.01em;
    margin: 0 0 22px;
    color: #f4f0e9;
  }
  .athoor-tv-card__name {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.gold_color }};
    font-weight: 500;
  }
  .athoor-tv-card__hint {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }

  /* Video layer */
  .athoor-tv-card__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #000;
  }
  .athoor-tv-card__media video,
  .athoor-tv-card__media iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    display: block;
  }

  /* Play button */
  .athoor-tv-card__play {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.6s ease 0.4s, transform 0.3s ease;
  }
  .athoor-tv-card.show-video .athoor-tv-card__play {
    opacity: 1;
  }
  .athoor-tv-card__play:hover {
    transform: translate(-50%,-50%) scale(1.08);
    background: {{ section.settings.gold_color }};
  }
  .athoor-tv-card__play svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
    fill: #1a1a1a;
  }
  .athoor-tv-card__play:hover svg { fill: #fff; }

  /* Fullscreen modal */
  .athoor-tv-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.92);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .athoor-tv-modal.is-open { display: flex; }
  .athoor-tv-modal__inner {
    position: relative;
    width: min(420px, 92vw);
    aspect-ratio: 9 / 16;
    background: #000;
    border-radius: 6px;
    overflow: hidden;
  }
  .athoor-tv-modal__inner video,
  .athoor-tv-modal__inner iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .athoor-tv-modal__close {
    position: absolute;
    top: -44px;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    border: none;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    color: #1a1a1a;
  }

  @media screen and (max-width: 749px) {
    .athoor-tv__title { font-size: 24px; }
    .athoor-tv-card { width: 300px; }
    .athoor-tv-card__quote { font-size: 15px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .athoor-tv-card { transition: opacity 0.4s ease; transform: none; }
  }
{%- endstyle -%}

<section class="athoor-tv" aria-label="{{ section.settings.title | default: 'Testimonials' }}">
  {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
    <div class="athoor-tv__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="athoor-tv__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="athoor-tv__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="athoor-tv__track">
    {%- for block in section.blocks -%}
      {%- assign reveal_delay = block.settings.reveal_delay | default: section.settings.reveal_delay -%}
      <div
        class="athoor-tv-card"
        data-tv-card
        data-reveal-delay="{{ reveal_delay }}"
        {{ block.shopify_attributes }}
      >
        <div class="athoor-tv-card__media" data-tv-media>
          {%- if block.settings.video != blank -%}
            <video
              data-tv-video
              src="{{ block.settings.video.sources[1].url | default: block.settings.video.sources[0].url }}"
              muted
              loop
              playsinline
              preload="none"
              poster="{{ block.settings.video.preview_image | image_url: width: 600 }}"
            ></video>
          {%- elsif block.settings.video_url != blank -%}
            <video
              data-tv-video
              src="{{ block.settings.video_url }}"
              muted
              loop
              playsinline
              preload="none"
              {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 600 }}"{% endif %}
            ></video>
          {%- elsif block.settings.instagram_url != blank -%}
            {%- assign ig = block.settings.instagram_url | split: '?' | first | append: 'embed' -%}
            <iframe
              data-tv-ig
              data-src="{{ ig }}"
              loading="lazy"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
          {%- endif -%}
        </div>

        <button class="athoor-tv-card__play" data-tv-open aria-label="Play full testimonial">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </button>

        <div class="athoor-tv-card__review">
          {%- if block.settings.rating > 0 -%}
            <div class="athoor-tv-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}{% if i <= block.settings.rating %}&#9733;{% else %}&#9734;{% endif %}{%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="athoor-tv-card__quote">&ldquo;{{ block.settings.text }}&rdquo;</p>
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <p class="athoor-tv-card__name">{{ block.settings.name }}</p>
          {%- endif -%}
          <span class="athoor-tv-card__hint">Watch their story</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<div class="athoor-tv-modal" data-tv-modal aria-hidden="true">
  <div class="athoor-tv-modal__inner" data-tv-modal-inner>
    <button class="athoor-tv-modal__close" data-tv-close aria-label="Close">&times;</button>
  </div>
</div>

<script>
(function() {
  var section = document.currentScript.previousElementSibling;
  var cards = document.querySelectorAll('[data-tv-card]');
  var modal = document.querySelector('[data-tv-modal]');
  var modalInner = modal ? modal.querySelector('[data-tv-modal-inner]') : null;

  // Reveal + review->video transition via IntersectionObserver
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        var card = entry.target;
        if (entry.isIntersecting) {
          card.classList.add('is-visible');
          var delay = parseInt(card.getAttribute('data-reveal-delay'), 10) || 2500;
          // Lazy-load IG iframe
          var ig = card.querySelector('[data-tv-ig]');
          if (ig && !ig.src && ig.dataset.src) ig.src = ig.dataset.src;
          // After delay, switch to video
          setTimeout(function() {
            card.classList.add('show-video');
            var vid = card.querySelector('[data-tv-video]');
            if (vid) {
              vid.preload = 'auto';
              var p = vid.play();
              if (p && p.catch) p.catch(function(){});
            }
          }, delay);
        } else {
          var vid2 = card.querySelector('[data-tv-video]');
          if (vid2) vid2.pause();
        }
      });
    }, { threshold: 0.4 });
    cards.forEach(function(c){ io.observe(c); });
  } else {
    cards.forEach(function(c){ c.classList.add('is-visible','show-video'); });
  }

  // Open fullscreen modal
  function openModal(card) {
    if (!modal || !modalInner) return;
    // clear previous
    modalInner.querySelectorAll('video,iframe').forEach(function(el){ el.remove(); });
    var srcVideo = card.querySelector('[data-tv-video]');
    var srcIg = card.querySelector('[data-tv-ig]');
    if (srcVideo) {
      var v = document.createElement('video');
      v.src = srcVideo.getAttribute('src');
      v.controls = true; v.autoplay = true; v.playsInline = true; v.loop = true;
      modalInner.appendChild(v);
    } else if (srcIg) {
      var f = document.createElement('iframe');
      f.src = srcIg.dataset.src || srcIg.src;
      f.allow = 'autoplay; encrypted-media';
      f.allowFullscreen = true;
      modalInner.appendChild(f);
    }
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden','true');
    modalInner.querySelectorAll('video,iframe').forEach(function(el){ el.remove(); });
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-tv-open]').forEach(function(btn){
    btn.addEventListener('click', function(){ openModal(btn.closest('[data-tv-card]')); });
  });
  // Also allow clicking the card media to open
  document.querySelectorAll('[data-tv-media]').forEach(function(m){
    m.addEventListener('click', function(){
      var card = m.closest('[data-tv-card]');
      if (card.classList.contains('show-video')) openModal(card);
    });
  });
  var closeBtn = document.querySelector('[data-tv-close]');
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) modal.addEventListener('click', function(e){ if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeModal(); });
})();
</script>

{% schema %}
{
  "name": "Testimonial Video",
  "tag": "section",
  "class": "section-athoor-tv",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REAL STORIES" },
    { "type": "text", "id": "title", "label": "Title", "default": "Loved by Many" },
    {
      "type": "range", "id": "reveal_delay", "min": 1000, "max": 5000, "step": 250,
      "unit": "ms", "label": "Review to video delay", "default": 2500
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f5" },
    { "type": "color", "id": "text_color", "label": "Title colour", "default": "#1a1a1a" },
    { "type": "color", "id": "gold_color", "label": "Gold accent", "default": "#B8960C" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "Sarah M." },
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review quote", "default": "Absolutely exceptional quality and service." },
        { "type": "header", "content": "Video source (choose one)" },
        { "type": "video", "id": "video", "label": "Shopify-hosted video" },
        { "type": "url", "id": "video_url", "label": "Direct MP4 URL" },
        { "type": "image_picker", "id": "poster", "label": "Video poster (for MP4 URL)" },
        { "type": "text", "id": "instagram_url", "label": "Instagram Reel URL", "info": "e.g. https://www.instagram.com/reel/XXXX/" },
        { "type": "range", "id": "reveal_delay", "min": 1000, "max": 5000, "step": 250, "unit": "ms", "label": "Per-card delay (0 = use section default)", "default": 2500 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Video",
      "blocks": [
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
