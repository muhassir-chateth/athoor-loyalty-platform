{%- style -%}
  .athoor-cats {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .athoor-cats__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .athoor-cats__title {
    /* Match the "Fragrances & Ouds" page heading exactly */
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 46px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: {{ section.settings.text_color }};
    margin: 0 0 48px;
  }
  @media screen and (max-width: 749px) {
    .athoor-cats__title {
      font-size: 28px;
      letter-spacing: 0.05em;
    }
  }
  .athoor-cats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .athoor-cat {
    display: block;
    text-decoration: none;
    text-align: center;
  }
  .athoor-cat__img {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f1eee8;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .athoor-cat__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .athoor-cat:hover .athoor-cat__img img { transform: scale(1.04); }
  .athoor-cat__img--placeholder {
    color: #b3a99c;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Coming soon — small top-right badge */
  .athoor-cat__soon {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    background: #1a1a1a;
    color: #fff;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 5px 9px;
    border-radius: 3px;
  }
  .athoor-cat.is-soon { cursor: default; }
  .athoor-cat.is-soon .athoor-cat__label { color: #8a8079; }
  .athoor-cat__label {
    display: inline-block;
    margin: 18px 0 0;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    padding-bottom: 8px;
    position: relative;
  }
  .athoor-cat__label::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 46px;
    height: 1px;
    background: {{ section.settings.accent_color }};
    transition: width 0.3s ease;
  }
  .athoor-cat:hover .athoor-cat__label::after { width: 80px; }

  @media screen and (max-width: 989px) {
    .athoor-cats__grid { grid-template-columns: repeat(2, 1fr); gap: 22px 18px; }
  }
  @media screen and (max-width: 749px) {
    .athoor-cats { padding: 44px 0 48px; }
    .athoor-cats__inner { padding: 0; overflow: hidden; }
    .athoor-cats__title { margin-bottom: 32px; padding: 0 20px; }
    .athoor-cat__label { font-size: 11px; letter-spacing: 0.16em; margin-top: 14px; }

    /* JS-controlled swipe track — one card per swipe, hard stop (no free motion) */
    .athoor-cats__grid {
      display: flex;
      grid-template-columns: none;
      gap: 14px;
      padding: 0 20px;
      transform: translateX(0);
      transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
      touch-action: pan-y;
      will-change: transform;
    }
    .athoor-cat { flex: 0 0 64%; }
  }
{%- endstyle -%}

<section class="athoor-cats" aria-label="{{ section.settings.title | escape }}">
  <div class="athoor-cats__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="athoor-cats__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="athoor-cats__grid" id="AthoorCatsGrid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="athoor-cat{% if block.settings.coming_soon %} is-soon{% endif %}" {{ block.shopify_attributes }}>
          <div class="athoor-cat__img">
            {%- if block.settings.coming_soon -%}
              <span class="athoor-cat__soon">Coming Soon</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.label | escape }}" loading="lazy" width="700" height="700">
            {%- else -%}
              <span class="athoor-cat__img--placeholder">Add image</span>
            {%- endif -%}
          </div>
          <span class="athoor-cat__label">{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var grid = document.getElementById('AthoorCatsGrid-{{ section.id }}');
    if (!grid) return;
    var mq = window.matchMedia('(max-width: 749px)');
    var index = 0;

    function step() {
      var first = grid.children[0];
      if (!first) return 0;
      var cs = getComputedStyle(grid);
      var gap = parseFloat(cs.columnGap || cs.gap) || 14;
      return first.getBoundingClientRect().width + gap;
    }
    function maxIndex() { return Math.max(0, grid.children.length - 1); }
    function go(i) {
      index = Math.max(0, Math.min(maxIndex(), i));
      grid.style.transform = 'translateX(' + (-(index * step())) + 'px)';
    }

    var x0 = null, y0 = null, locked = false;
    grid.addEventListener('touchstart', function (e) {
      if (!mq.matches) return;
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
      locked = false;
    }, { passive: true });

    grid.addEventListener('touchmove', function (e) {
      if (!mq.matches || x0 === null) return;
      var dx = e.touches[0].clientX - x0;
      var dy = e.touches[0].clientY - y0;
      if (!locked && Math.abs(dx) > Math.abs(dy)) locked = true; // horizontal intent
    }, { passive: true });

    grid.addEventListener('touchend', function (e) {
      if (!mq.matches || x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      var dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 36 && Math.abs(dx) > Math.abs(dy)) {
        go(index + (dx < 0 ? 1 : -1));
      }
      x0 = null;
    }, { passive: true });

    function reset() {
      if (mq.matches) { go(index); }
      else { grid.style.transform = ''; }
    }
    if (mq.addEventListener) mq.addEventListener('change', reset);
    window.addEventListener('resize', reset);
    reset();
  })();
</script>

{% schema %}
{
  "name": "Discover Categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Discover a world of scents" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f5" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Underline accent", "default": "#B8960C" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (leave blank for now)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "checkbox", "id": "coming_soon", "label": "Coming soon badge", "default": false },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Discover Categories",
      "blocks": [
        { "type": "category", "settings": { "label": "Fragrances" } },
        { "type": "category", "settings": { "label": "Scented Candles" } },
        { "type": "category", "settings": { "label": "Car / Home Diffusers" } },
        { "type": "category", "settings": { "label": "Travel Sets" } }
      ]
    }
  ]
}
{% endschema %}
