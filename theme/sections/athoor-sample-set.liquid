{%- style -%}
  .athoor-sample {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    position: relative;
    z-index: 2;
  }
  .athoor-sample__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .athoor-sample__content { text-align: center; }
  .athoor-sample__eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.gold_color }};
    margin: 0 0 14px;
  }
  .athoor-sample__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0.02em;
    margin: 0 0 16px;
    color: {{ section.settings.text_color }};
  }
  .athoor-sample__text {
    font-size: 15px;
    line-height: 1.6;
    color: #6b6258;
    font-weight: 300;
    margin: 0 auto 28px;
    max-width: 380px;
  }
  .athoor-sample__customize {
    display: inline-block;
    background: none;
    border: none;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    cursor: pointer;
    padding: 0 0 6px;
    border-bottom: 1px solid {{ section.settings.text_color }};
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .athoor-sample__customize:hover {
    color: {{ section.settings.gold_color }};
    border-color: {{ section.settings.gold_color }};
  }

  /* Image */
  .athoor-sample__media img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
  .athoor-sample__media--placeholder {
    aspect-ratio: 1 / 1;
    max-height: 420px;
    background: #ece6dd;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #b3a99c;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Selection form (hidden until Customize) */
  .athoor-sample__form {
    display: none;
    margin-top: 28px;
    text-align: left;
    max-width: 380px;
    margin-left: auto;
    margin-right: auto;
  }
  .athoor-sample__form.is-open { display: block; }

  .athoor-sample__group { margin-bottom: 22px; }
  .athoor-sample__group-title {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e3dcd0;
  }
  .athoor-sample__check {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    font-size: 14px;
    color: #1a1a1a;
    cursor: pointer;
  }
  .athoor-sample__check input {
    width: 18px;
    height: 18px;
    accent-color: #1a1a1a;
    cursor: pointer;
    flex-shrink: 0;
  }
  .athoor-sample__check input:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .athoor-sample__check input:disabled + span { opacity: 0.4; }

  .athoor-sample__counter {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #8a8079;
    text-align: center;
    margin: 4px 0 16px;
  }
  .athoor-sample__add {
    width: 100%;
    height: 52px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s ease, opacity 0.3s ease;
  }
  .athoor-sample__add:hover { background: {{ section.settings.gold_color }}; }
  .athoor-sample__add:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    background: #1a1a1a;
  }
  .athoor-sample__note {
    font-size: 12px;
    color: #8a8079;
    text-align: center;
    margin-top: 12px;
  }

  @media screen and (max-width: 749px) {
    .athoor-sample {
      padding: 40px 0 48px;
    }
    .athoor-sample__inner {
      grid-template-columns: 1fr;
      gap: 22px;
      text-align: center;
      padding: 0 20px;
    }
    .athoor-sample__media { order: 2; margin-top: 4px; }
    .athoor-sample__media img,
    .athoor-sample__media--placeholder {
      max-width: 240px;
      margin: 0 auto;
    }
    .athoor-sample__eyebrow {
      font-size: 9px;
      letter-spacing: 0.22em;
      margin: 0 0 10px;
    }
    .athoor-sample__title {
      font-size: 19px;
      letter-spacing: 0.04em;
      line-height: 1.3;
      margin: 0 0 10px;
    }
    .athoor-sample__text {
      font-size: 12px;
      line-height: 1.55;
      max-width: 300px;
      margin: 0 auto 20px;
    }
    .athoor-sample__customize {
      font-size: 11px;
      letter-spacing: 0.18em;
    }
    .athoor-sample__field label {
      font-size: 10px;
    }
    .athoor-sample__field select {
      height: 42px;
      font-size: 13px;
    }
    .athoor-sample__add {
      height: 48px;
      font-size: 11px;
      letter-spacing: 0.16em;
    }
    .athoor-sample__note {
      font-size: 11px;
    }
  }

  /* Sticky add-to-cart bar — only visible while the sample section is on screen */
  .athoor-sample__sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: #ffffff;
    border-top: 1px solid #ece6dd;
    box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.06);
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    transform: translateY(110%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.32s ease, opacity 0.32s ease, visibility 0.32s ease;
  }
  .athoor-sample__sticky.is-visible {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .athoor-sample__sticky-tagline {
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #6b6258;
    text-align: center;
    font-weight: 300;
  }
  .athoor-sample__sticky-form { margin: 0; }
  .athoor-sample__sticky-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .athoor-sample__sticky-add {
    flex: 1 1 50%;
    height: 48px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .athoor-sample__sticky-add:hover { background: {{ section.settings.gold_color }}; }
  .athoor-sample__sticky-row .shopify-payment-button {
    flex: 1 1 50%;
    margin: 0;
  }
  .athoor-sample__sticky-row .shopify-payment-button__button {
    min-height: 48px;
    border-radius: 4px;
  }
  /* Hide sticky bar on desktop — mobile-first feature */
  @media screen and (min-width: 750px) {
    .athoor-sample__sticky { display: none; }
  }
  /* Reserve space so sticky bar never covers footer content on mobile */
  @media screen and (max-width: 749px) {
    .athoor-sample { padding-bottom: 96px; }
  }

  /* Desktop: Atkinsons-style — large image left, text centred right */
  @media screen and (min-width: 750px) {
    .athoor-sample {
      padding-top: 0;
      padding-bottom: 0;
    }
    .athoor-sample__inner {
      max-width: 100%;
      padding: 0;
      gap: 0;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 540px;
    }
    .athoor-sample__media {
      order: 1;
      display: block;
      height: 100%;
    }
    .athoor-sample__media img,
    .athoor-sample__media--placeholder {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      object-fit: cover;
      border-radius: 0;
      margin: 0;
    }
    .athoor-sample__content {
      order: 2;
      align-self: center;
      text-align: center;
      padding: 48px 64px;
    }
    .athoor-sample__title {
      font-size: 40px;
      line-height: 1.15;
      margin-bottom: 18px;
    }
    .athoor-sample__text {
      font-size: 15px;
      max-width: 360px;
      margin-bottom: 26px;
    }
  }
{%- endstyle -%}

<section class="athoor-sample" aria-label="Custom Sample Set">
  <div class="athoor-sample__inner">
    <div class="athoor-sample__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="athoor-sample__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="athoor-sample__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="athoor-sample__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <a href="/products/custom-sample-set" class="athoor-sample__customize">
        {{ section.settings.button_label }}
      </a>
      {%- if section.settings.note != blank -%}
        <p class="athoor-sample__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="athoor-sample__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" loading="lazy" width="800" height="800">
      {%- else -%}
        <div class="athoor-sample__media--placeholder">Add sample set image</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Sticky add-to-cart bar (mobile) {%- endcomment -%}
  {%- if section.settings.enable_sticky -%}
    {%- assign ss_product = all_products['custom-sample-set'] -%}
    {%- if ss_product != blank -%}
      {%- assign ss_variant = ss_product.variants | where: 'title', '3 Samples' | first -%}
      {%- unless ss_variant -%}{%- assign ss_variant = ss_product.selected_or_first_available_variant -%}{%- endunless -%}
      <div class="athoor-sample__sticky" data-sample-sticky>
        {%- if section.settings.sticky_tagline != blank -%}
          <p class="athoor-sample__sticky-tagline">{{ section.settings.sticky_tagline }}</p>
        {%- endif -%}
        {%- form 'product', ss_product, id: 'sample-sticky-form', class: 'athoor-sample__sticky-form' -%}
          <input type="hidden" name="id" value="{{ ss_variant.id }}">
          <div class="athoor-sample__sticky-row">
            <button type="submit" name="add" class="athoor-sample__sticky-add">Add to Cart</button>
            {{ form | payment_button }}
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<script>
(function() {
  var section = document.querySelector('.athoor-sample');
  var sticky = document.querySelector('[data-sample-sticky]');

  // Show the sticky bar only while the sample section is in view; hide once scrolled past.
  if (section && sticky && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        sticky.classList.toggle('is-visible', entry.isIntersecting);
      });
    }, { threshold: 0.18 });
    observer.observe(section);
  } else if (sticky) {
    // Fallback: just show it
    sticky.classList.add('is-visible');
  }

  var toggle = document.querySelector('[data-sample-toggle]');
  var form = document.querySelector('[data-sample-form]');
  if (toggle && form) {
    toggle.addEventListener('click', function() {
      form.classList.toggle('is-open');
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
  if (!form) return;

  var max = {{ section.settings.choices | default: 3 }};
  var checks = form.querySelectorAll('[data-sample-check]');
  var counter = form.querySelector('[data-sample-counter]');
  var summary = form.querySelector('[data-sample-summary]');
  var submit = form.querySelector('[data-sample-submit]');

  function update() {
    var selected = [];
    checks.forEach(function(c) { if (c.checked) selected.push(c.value); });

    var atMax = selected.length >= max;
    checks.forEach(function(c) { if (!c.checked) c.disabled = atMax; });

    if (counter) {
      counter.textContent = 'Select ' + max + ' fragrances · ' + selected.length + '/' + max;
    }
    if (summary) summary.value = selected.join(', ');
    if (submit) submit.disabled = selected.length !== max;
  }

  checks.forEach(function(c) { c.addEventListener('change', update); });
  update();
})();
</script>

{% schema %}
{
  "name": "Custom Sample Set",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DISCOVER YOUR SCENT" },
    { "type": "text", "id": "title", "label": "Title", "default": "Try it with our Custom Sample Set" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose your favourite scents and enjoy your fragrant selection." },
    { "type": "text", "id": "button_label", "label": "Customize button label", "default": "Customize" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add Sample Set" },
    { "type": "range", "id": "choices", "min": 2, "max": 6, "step": 1, "label": "Number of fragrances to choose", "default": 3 },
    { "type": "text", "id": "note", "label": "Note under button", "default": "Choose 3 fragrances · 1.2ml each" },
    { "type": "header", "content": "Sticky bar (mobile)" },
    { "type": "checkbox", "id": "enable_sticky", "label": "Show sticky Add to Cart bar on mobile", "default": true },
    { "type": "text", "id": "sticky_tagline", "label": "Sticky bar tagline", "default": "3 Samples · 1.2ml each — £5.99" },
    { "type": "header", "content": "Products" },
    { "type": "product", "id": "sample_product", "label": "Sample set product", "info": "The product added to cart (create a 'Custom Sample Set' product in admin)" },
    { "type": "collection", "id": "scent_collection", "label": "Fragrances to choose from" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Sample set image" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f5" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#1a1a1a" },
    { "type": "color", "id": "gold_color", "label": "Gold accent", "default": "#B8960C" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "presets": [ { "name": "Custom Sample Set" } ]
}
{% endschema %}
