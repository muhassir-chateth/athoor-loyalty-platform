# =============================================================================
# Athoor Loyalty Service — environment configuration (EXAMPLE / PLACEHOLDERS)
# -----------------------------------------------------------------------------
# Copy to `.env` and fill with REAL values locally. NEVER commit `.env`.
#
# Requirement 11.7: production must use a DEDICATED custom-app Admin API token
# created specifically for the loyalty service. Do NOT reuse the local MCP
# credential from .kiro/settings/mcp.json — that token belongs to the IDE
# tooling and may carry different scopes or be rotated independently.
# The real protection is operational: a separate custom app with least-privilege
# scopes, not a prefix-based code check.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Requirement 11.11: all traffic must be served over HTTPS in production.
# When true, the service asserts an HTTPS-terminating context (proxy/edge)
# and will refuse to boot in production without it.
REQUIRE_HTTPS=false

# --- Shopify custom app ------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=myathoorlondon.myshopify.com

# Admin API access token for the dedicated custom app (NOT the MCP shpat_ token).
SHOPIFY_ADMIN_API_TOKEN=REPLACE_WITH_CUSTOM_APP_ADMIN_TOKEN

# Shared secret used to verify inbound webhook HMAC-SHA256 signatures (Req 11.1/11.2).
SHOPIFY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# App Proxy shared secret used to verify signed storefront requests (Req 11.3/11.4).
SHOPIFY_APP_PROXY_SECRET=REPLACE_WITH_APP_PROXY_SHARED_SECRET

# --- Admin management surface (task 17.1, Req 10.1) --------------------------
# Shared secret presented as `Authorization: Bearer <secret>` by an Admin_User
# to reach the /v1/admin/* tools. When unset, the admin surface fails closed
# (denies all access). Swap in an SSO/JWT-backed authenticator for richer setups.
ADMIN_AUTH_SECRET=REPLACE_WITH_ADMIN_SHARED_SECRET

# --- Membership-Credential service (task 19.2, Req 19.5/19.6) ----------------
# DEDICATED signing key for the Digital Membership Card / QR member identifier.
# Used ONLY to sign + verify the opaque, non-PII member id + tier — never reuse
# the Admin token, webhook secret, or App Proxy secret here. When unset, the
# /v1/membership-card surface fails closed. Rotate on schedule. Generate with
# e.g. `openssl rand -hex 32`.
MEMBERSHIP_SIGNING_KEY=REPLACE_WITH_DEDICATED_MEMBERSHIP_SIGNING_KEY

# --- Database (PostgreSQL) ---------------------------------------------------
# Either provide DATABASE_URL, or the discrete PG* values below.
DATABASE_URL=postgres://loyalty:REPLACE_WITH_PASSWORD@localhost:5432/loyalty
PGHOST=localhost
PGPORT=5432
PGUSER=loyalty
PGPASSWORD=REPLACE_WITH_PASSWORD
PGDATABASE=loyalty
# Require TLS to the database in production.
PGSSL=false
