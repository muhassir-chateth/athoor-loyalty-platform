{
  "name": "athoor-loyalty-service",
  "version": "1.0.0",
  "private": true,
  "description": "Athoor London loyalty microservice — immutable ledger, versioned /v1 API (Node.js + TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "fast-check": "^3.23.2",
    "node-pg-migrate": "^7.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
