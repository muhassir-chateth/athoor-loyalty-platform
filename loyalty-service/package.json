{
  "name": "athoor-loyalty-service",
  "version": "1.0.0",
  "private": true,
  "description": "Athoor London loyalty microservice — immutable ledger, versioned /v1 API (Node.js + TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:portal": "tsc -p ../theme-src/tsconfig.json",
    "build:portal": "node scripts/build/portal-assets.mjs",
    "build:portal:check": "node scripts/build/portal-assets.mjs --check",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "npm run build && node scripts/migration/migrate-down-guard.mjs && node-pg-migrate down",
    "migrate:down:check": "npm run build && node scripts/migration/migrate-down-guard.mjs",
    "cutover:m0": "node scripts/migration/m0-export.mjs",
    "cutover:m1": "node scripts/migration/m1-backfill.mjs",
    "cutover:rollback": "node scripts/migration/metafield-rollback.mjs"
  },
  "dependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "^3.23.2",
    "jsdom": "26.1.0",
    "node-pg-migrate": "^7.9.0",
    "vitest": "^2.1.8"
  }
}
